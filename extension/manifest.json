{
  "manifest_version": 3,
  "name": "Nolane Browser Companion",
  "version": "0.2.10",
  "minimum_chrome_version": "116",
  "description": "Capture real Chrome tabs into Nolane, diagnose site compatibility and safely apply recommended video recovery actions.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "debugger"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nolane Browser Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nolane-x.github.io/web-view/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
