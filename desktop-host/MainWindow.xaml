<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Nolane.DesktopHost.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Grid Background="{x:Null}">
    <Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Height="0" Opacity="0" IsHitTestVisible="False">
      <Grid>
        <TextBlock x:Name="StatusText" Text="Nolane background bridge" />
        <StackPanel>
          <Button x:Name="DownloadsButton" Content="Downloads (0)" Click="ToggleDownloads_Click" />
          <Button x:Name="LibraryButton" Content="Library (0)" Click="ToggleLibrary_Click" />
          <Button x:Name="ProfilesButton" Content="Profiles" Click="ManageProfiles_Click" IsEnabled="False" />
          <Button Content="Reload workspace" Click="ReloadWorkspace_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceRoot" Grid.Row="1" Background="{x:Null}">
      <controls:WebView2 x:Name="WorkspaceView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Canvas x:Name="BrowserSurfaceLayer" Background="{x:Null}" IsHitTestVisible="True" />
      <Border x:Name="DownloadsPanel" Width="420" MaxWidth="520" Margin="0,10,10,10"
              Padding="0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="#111722" BorderBrush="#344158" BorderThickness="1"
              CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="True">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Background="#171F2D" BorderBrush="#2C374B" BorderThickness="0,0,0,1"
                  CornerRadius="12,12,0,0" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="Downloads" FontSize="15" FontWeight="SemiBold" Foreground="#EDF2FA" />
                <TextBlock x:Name="DownloadsSummaryText" Text="Recent website downloads" FontSize="10" Foreground="#93A0B4" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button Content="Clear finished" Click="ClearFinishedDownloads_Click" Padding="8,5" FontSize="10" />
                <Button Content="Close" Click="CloseDownloads_Click" Padding="8,5" FontSize="10" />
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DownloadsList" Padding="10" Spacing="8" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
