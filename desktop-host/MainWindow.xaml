<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Nolane.DesktopHost.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Grid Background="#0B0D12">
    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#121722" BorderBrush="#263044" BorderThickness="0,0,0,1">
      <Grid Padding="12,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="8" Height="8" CornerRadius="4" Background="#65D6A0" />
          <TextBlock Text="NOLANE NATIVE WEB" FontSize="11" FontWeight="SemiBold" Foreground="#EDF2FA" />
          <TextBlock Text="·" Foreground="#657187" />
          <TextBlock Text="Real embedded browser surfaces" FontSize="10" Foreground="#9BA8BC" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting WebView2…" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="#9BA8BC" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="DownloadsButton" Content="Downloads (0)" Click="ToggleDownloads_Click" Padding="10,3" FontSize="10" />
          <Button x:Name="LibraryButton" Content="Library (0)" Click="ToggleLibrary_Click" Padding="10,3" FontSize="10" />
          <Button Content="Reload workspace" Click="ReloadWorkspace_Click" Padding="10,3" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <controls:WebView2 x:Name="WorkspaceView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      <Canvas x:Name="BrowserSurfaceLayer" Background="{x:Null}" IsHitTestVisible="True" />
      <Border x:Name="DownloadsPanel" Grid.Row="1" Width="420" MaxWidth="520"
              Margin="0,10,10,10" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="#111722" BorderBrush="#344158" BorderThickness="1"
              CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="True">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Background="#171F2D" BorderBrush="#2C374B" BorderThickness="0,0,0,1"
                  CornerRadius="12,12,0,0" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="Downloads" FontSize="15" FontWeight="SemiBold" Foreground="#EDF2FA" />
                <TextBlock x:Name="DownloadsSummaryText" Text="Your recent website downloads" FontSize="10" Foreground="#93A0B4" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button Content="Clear finished" Click="ClearFinishedDownloads_Click" Padding="8,5" FontSize="10" />
                <Button Content="Close" Click="CloseDownloads_Click" Padding="8,5" FontSize="10" />
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DownloadsList" Padding="10" Spacing="8" />
          </ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="LibraryPanel" Grid.Row="1" Width="420" MaxWidth="520"
              Margin="0,10,10,10" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="#111722" BorderBrush="#344158" BorderThickness="1"
              CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="True">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Background="#171F2D" BorderBrush="#2C374B" BorderThickness="0,0,0,1"
                  CornerRadius="12,12,0,0" Padding="14,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="Library" FontSize="15" FontWeight="SemiBold" Foreground="#EDF2FA" />
                <TextBlock x:Name="LibrarySummaryText" Text="Your browsing history and saved pages" FontSize="10" Foreground="#93A0B4" />
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,10,0,0">
                <Button x:Name="HistoryTabButton" Content="History" Click="ShowHistory_Click" Padding="9,5" FontSize="10" />
                <Button x:Name="BookmarksTabButton" Content="Bookmarks" Click="ShowBookmarks_Click" Padding="9,5" FontSize="10" />
                <Button x:Name="ClearHistoryButton" Content="Clear history" Click="ClearHistory_Click" Padding="9,5" FontSize="10" />
                <Button Content="Close" Click="CloseLibrary_Click" Padding="9,5" FontSize="10" />
              </StackPanel>
              <TextBox x:Name="LibrarySearchBox" Grid.Row="2" Margin="0,9,0,0"
                       PlaceholderText="Search title, domain or address"
                       TextChanged="LibrarySearch_TextChanged" MinHeight="32" />
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,9,0,0">
                <Button Content="Export backup" Click="ExportLibrary_Click" Padding="9,5" FontSize="10" />
                <Button Content="Import backup" Click="ImportLibrary_Click" Padding="9,5" FontSize="10" />
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LibraryItems" Padding="10" Spacing="8" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>